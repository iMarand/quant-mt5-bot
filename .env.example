# Copy to `.env` and fill in. `.env` is git-ignored; this template is not.
#
# Use the MASTER password, not the investor password — the investor password
# connects read-only, so orders would be rejected.

QUANTBOT_MT5_LOGIN=
QUANTBOT_MT5_PASSWORD=
QUANTBOT_MT5_SERVER=MetaQuotes-Demo

# Path to terminal64.exe. Only needed if MT5 is installed somewhere unusual.
# QUANTBOT_MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Broker used by `run`: paper (default) or mt5.
# QUANTBOT_BROKER=mt5

# Licensed calendar feed, if you have one (see connectors/investing.py).
# QUANTBOT_INVESTING_API_KEY=
